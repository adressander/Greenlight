# Copy this file to .env.local for local development.
# In production (Vercel), set these in Project Settings → Environment Variables.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Any random long string — protects the /api/check-deadlines cron route
CRON_SECRET=

# Twilio → console.twilio.com. Leave blank to run without SMS (dashboard still works).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
